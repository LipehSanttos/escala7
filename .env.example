# ==============================================================================
# ESCALA7 - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# NUNCA envie senhas ou chaves reais para o repositório público do GitHub!
# ==============================================================================

# Segurança do Sistema
# PIN mestre para o perfil de Administrador Geral da igreja (Ex: 777, 1844, ou sua senha forte)
ADMIN_PIN=definir_pin_seguro_aqui

# Configurações do Supabase (PostgreSQL em Nuvem)
# Obtenha estas credenciais em: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada-service-role-aqui

# Conexão direta PostgreSQL (Opcional - para migrations e Prisma se aplicável)
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres

# Configurações do Cloudflare (Opcional - para deploys via Cloudflare Pages)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
